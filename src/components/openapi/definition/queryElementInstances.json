{
  "id": "queryElementInstances",
  "method": "POST",
  "requestUri": "/element-instances/query",
  "properties": [
    {
      "name": "partition",
      "description": "Partition filter.",
      "type": "string",
      "format": "date"
    },
    {
      "name": "id",
      "description": "Element instance filter.",
      "type": "integer",
      "format": "int32"
    },
    {
      "name": "bpmnElementId",
      "description": "BPMN element ID filter.",
      "type": "string"
    },
    {
      "name": "parentId",
      "description": "Filter, used to query children of a parent element instance.",
      "type": "integer",
      "format": "int32"
    },
    {
      "name": "processId",
      "description": "Process filter.",
      "type": "integer",
      "format": "int32"
    },
    {
      "name": "processInstanceId",
      "description": "Process instance filter.",
      "type": "integer",
      "format": "int32"
    },
    {
      "name": "states",
      "description": "States to include.",
      "type": "array",
      "items": {
        "description": "InstanceState describes possible process instance and element instance states.",
        "type": "string"
      }
    },
    {
      "name": "offset",
      "description": "The number of results to skip, before returning any result. If offset is \u003ccode class='description-code'\u003e0\u003c/code\u003e, no results are skipped.",
      "type": "integer",
      "format": "int32",
      "inQuery": true
    },
    {
      "name": "limit",
      "description": "Maximum number of results to return. If limit is \u003ccode class='description-code'\u003e0\u003c/code\u003e, all results are returned.",
      "type": "integer",
      "format": "int32",
      "inQuery": true
    }
  ]
}