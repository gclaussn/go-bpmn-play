{
  "id": "queryUserTasks",
  "method": "POST",
  "requestUri": "/user-tasks/query",
  "properties": [
    {
      "name": "partition",
      "description": "Partition filter.",
      "type": "string",
      "format": "date"
    },
    {
      "name": "id",
      "description": "User task filter.",
      "type": "integer",
      "format": "int32"
    },
    {
      "name": "elementInstanceId",
      "description": "Element instance filter.",
      "type": "integer",
      "format": "int32"
    },
    {
      "name": "processId",
      "description": "Process filter.",
      "type": "integer",
      "format": "int32"
    },
    {
      "name": "processInstanceId",
      "description": "Process instance filter.",
      "type": "integer",
      "format": "int32"
    },
    {
      "name": "tags",
      "description": "Tags, a user task must have, to be included.",
      "type": "array",
      "items": {
        "description": "Tag is used to tag processes, process instances and user tasks.",
        "type": "object",
        "properties": [
          {
            "name": "name",
            "required": true,
            "description": "Tag name.",
            "type": "string"
          },
          {
            "name": "value",
            "description": "Tag value.",
            "type": "string"
          }
        ]
      }
    },
    {
      "name": "offset",
      "description": "The number of results to skip, before returning any result. If offset is \u003ccode class='description-code'\u003e0\u003c/code\u003e, no results are skipped.",
      "type": "integer",
      "format": "int32",
      "inQuery": true
    },
    {
      "name": "limit",
      "description": "Maximum number of results to return. If limit is \u003ccode class='description-code'\u003e0\u003c/code\u003e, all results are returned.",
      "type": "integer",
      "format": "int32",
      "inQuery": true
    }
  ]
}